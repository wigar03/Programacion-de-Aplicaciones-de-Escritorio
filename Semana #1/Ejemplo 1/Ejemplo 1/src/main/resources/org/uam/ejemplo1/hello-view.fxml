<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.uam.ejemplo1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="lblsaludar" text="Hola, Bienvenido!"/>
    <Label fx:id="lblnombre" text="Nombre"/>
    <TextField fx:id="tfname" layoutX="100" layoutY="80" prefWidth="250.0" promptText="Juan Andres"/>

    <Label fx:id="lblapellido" text="Apellido"/>
    <TextField fx:id="tfapellido" layoutX="100" layoutY="80" prefWidth="250.0" promptText="Araica Lopez"/>

    <Label fx:id="lblcorreo" text="Correo"/>
    <TextField fx:id="tfcorreo" layoutX="100" layoutY="80" prefWidth="250.0" promptText="example@correo.com"/>

    <Button text="Enviar" onAction="#onHelloButtonClick"/>
</VBox>
